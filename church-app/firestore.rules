rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function me(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function admin(){return signedIn() && me().role == 'admin';}
  match /users/{userId}{allow read: if signedIn();allow create: if signedIn()&&request.auth.uid==userId;allow update: if signedIn()&&request.auth.uid==userId&&!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);}
  match /posts/{postId}{allow read: if signedIn();allow create: if signedIn()&&request.resource.data.authorId==request.auth.uid;allow update: if signedIn()&&(resource.data.authorId==request.auth.uid||admin()||request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy','bookmarkedBy']));allow delete: if signedIn()&&(resource.data.authorId==request.auth.uid||admin());match /comments/{commentId}{allow read:if signedIn();allow create:if signedIn()&&request.resource.data.authorId==request.auth.uid;allow delete:if signedIn()&&(resource.data.authorId==request.auth.uid||admin());}}
  match /businessAds/{id}{allow read:if signedIn();allow create:if signedIn()&&request.resource.data.ownerId==request.auth.uid;allow update,delete:if signedIn()&&(resource.data.ownerId==request.auth.uid||admin());}
  match /liveStream/{id}{allow read:if signedIn();allow write:if admin();}
  match /friendRequests/{id}{allow read:if signedIn()&&(resource.data.fromId==request.auth.uid||resource.data.toId==request.auth.uid);allow create:if signedIn()&&request.resource.data.fromId==request.auth.uid;allow update:if signedIn()&&resource.data.toId==request.auth.uid;allow delete:if signedIn()&&(resource.data.fromId==request.auth.uid||resource.data.toId==request.auth.uid);}
  match /friendships/{id}{allow read:if signedIn()&&request.auth.uid in resource.data.users;allow create:if signedIn()&&request.auth.uid in request.resource.data.users;}
  match /conversations/{id}{allow read,create,update:if signedIn()&&(request.auth.uid in resource.data.participants||request.auth.uid in request.resource.data.participants);match /messages/{mid}{allow read:if signedIn()&&request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants;allow create:if signedIn()&&request.auth.uid==request.resource.data.senderId&&request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants;}}
  match /groups/{id}{allow read:if signedIn();allow create:if signedIn()&&request.resource.data.ownerId==request.auth.uid;allow update:if signedIn();}
  match /events/{id}{allow read:if signedIn();allow create,update,delete:if admin();}
  match /prayerCalls/{id}{allow read:if signedIn();allow create,update,delete:if admin();}
  match /bibleStudies/{id}{allow read:if signedIn();allow create,update,delete:if admin();}
  match /announcements/{id}{allow read:if signedIn();allow create,update,delete:if admin();}
  match /prayerRequests/{id}{allow read:if signedIn();allow create:if signedIn()&&request.resource.data.authorId==request.auth.uid;allow update,delete:if admin()||(signedIn()&&resource.data.authorId==request.auth.uid);}
 }
}
